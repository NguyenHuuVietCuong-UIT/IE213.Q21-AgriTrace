# Server
PORT=5000

# Database
MONGO_URI=your_mongodb_connection_string

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Pinata IPFS
PINATA_API_KEY=your_pinata_api_key
