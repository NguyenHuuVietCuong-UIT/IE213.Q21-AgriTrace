# Stream 5 Environment Configuration Template
# Copy this to your .env file and fill in with actual values

# ==========================================
# BLOCKCHAIN CONFIGURATION (Stream 5)
# ==========================================

# RPC URL for Ethereum-compatible blockchain
# Examples:
#   - Sepolia Testnet: https://sepolia.infura.io/v3/YOUR_INFURA_KEY
#   - Polygon Mumbai: https://rpc-mumbai.maticvigil.com
#   - Local Hardhat: http://localhost:8545
ETH_RPC_URL=https://your-rpc-endpoint-here.com/v3/your-key

# System Admin Private Key (Wallet that will sign transactions)
# ⚠️ SECURITY WARNING: 
#   - NEVER commit this to Git repository
#   - Use environment variables or secrets manager in production
#   - This wallet must have sufficient balance for gas fees
#   - Format: 0x prefixed 64 hex characters (no quotes)
SYSTEM_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Deployed NFT Smart Contract Address
# Format: 0x prefixed 40 hex characters
NFT_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# ==========================================
# IPFS CONFIGURATION (Pinata)
# ==========================================

# Pinata API Key
# Get from: https://www.pinata.cloud
PINATA_API_KEY=your_pinata_api_key_here

# Pinata API Secret
PINATA_API_SECRET=your_pinata_api_secret_here

# Optional: Custom IPFS Gateway
# Default: https://gateway.pinata.cloud
IPFS_GATEWAY_URL=https://gateway.pinata.cloud

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/agritrace

# Alternative for local MongoDB:
# MONGO_URI=mongodb://localhost:27017/agritrace

# ==========================================
# SERVER CONFIGURATION
# ==========================================

# Backend Port
PORT=8080

# Node Environment
NODE_ENV=development

# ==========================================
# JWT CONFIGURATION
# ==========================================

# Secret key for JWT signing
JWT_SECRET=your_jwt_secret_key_here

# JWT Expiration
JWT_EXPIRES_IN=7d

# ==========================================
# TESTING CONFIGURATION (Optional)
# ==========================================

# API URL for testing
API_URL=http://localhost:8080/api

# Test JWT Token (for test-stream5-shipping.js)
# Obtain by logging in as a user and copying the token
TEST_JWT_TOKEN=your_jwt_token_for_testing

# Test Batch ID (for test-stream5-shipping.js)
# Use a batch with status='MINTED' and valid tokenId
TEST_BATCH_ID=507f1f77bcf86cd799439011

# ==========================================
# LOGGING CONFIGURATION (Optional)
# ==========================================

# Log Level: error, warn, info, debug
LOG_LEVEL=info

# Enable detailed error logging
DEBUG=agritrace:*

# ==========================================
# SETUP CHECKLIST
# ==========================================

# Before using Stream 5, ensure you have:
#
# [ ] Created a Pinata account and got API credentials
# [ ] Deployed the BatchNFT smart contract to your blockchain
# [ ] Set up a system admin wallet with ETH balance
# [ ] Generated a JWT token for testing
# [ ] Created/identified a test batch with status='MINTED'
# [ ] Set up MongoDB database
# [ ] Configured all environment variables below

# ==========================================
# VERIFICATION COMMANDS
# ==========================================

# 1. Test blockchain connection:
#    node -e "require('ethers'); console.log('ethers.js loaded')"

# 2. Test Pinata connection:
#    curl -H "pinata_api_key: $PINATA_API_KEY" https://api.pinata.cloud/data/testAuthentication

# 3. Test MongoDB connection:
#    mongo "mongodb://localhost:27017" --eval "db.adminCommand('ping')"

# 4. Run Stream 5 tests:
#    node test-stream5-shipping.js
